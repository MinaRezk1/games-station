rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isGoogleUser() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['minamessi1218@gmail.com'];
    }
    function room(code) {
      return get(/databases/$(database)/documents/rooms/$(code)).data;
    }
    function isHost(code) {
      return signedIn() && room(code).hostId == request.auth.uid;
    }
    function validChoice(c) {
      return c is int
        || (c is list && c.size() <= 10)
        || (c is string && c.size() > 0 && c.size() <= 100);
    }

    // المسابقات: كل مسؤول يشوف ويعدّل مسابقاته هو بس
    match /quizzes/{quizId} {
      allow create: if isGoogleUser()
        && request.resource.data.ownerId == request.auth.uid;
      allow read, delete: if isGoogleUser()
        && resource.data.ownerId == request.auth.uid;
      allow update: if isGoogleUser()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid;
    }

    // الغرف اللايف
    match /rooms/{code} {
      allow read: if signedIn();
      allow create: if isGoogleUser()
        && request.resource.data.hostId == request.auth.uid;
      allow update: if isGoogleUser()
        && resource.data.hostId == request.auth.uid
        && request.resource.data.hostId == request.auth.uid;
      allow delete: if isGoogleUser()
        && resource.data.hostId == request.auth.uid;

      // حاجات المسؤول بس يشوفها (زي ترتيب خلط الاختيارات)
      match /secret/{docId} {
        allow read, write: if isHost(code);
      }

      // اللاعبين
      match /players/{uid} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.auth.uid == uid
          && room(code).status != 'ended'
          && request.resource.data.keys().hasOnly(['name', 'score', 'joinedAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 30
          && request.resource.data.score == 0
          && request.resource.data.joinedAt == request.time;
        // المسؤول بيعدّل النقط، واللاعب يقدر يظبط الساعة بس
        allow update: if (isHost(code)
            && request.resource.data.name == resource.data.name)
          || (signedIn()
            && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clockSync'])
            && request.resource.data.clockSync == request.time);
        allow delete: if isHost(code);
      }

      // الإجابات: كل لاعب يجاوب مرة واحدة بس وفي الوقت المسموح
      match /answers/{answerId} {
        allow create: if signedIn()
          && answerId == request.auth.uid + '_' + string(request.resource.data.qIndex)
          && request.resource.data.keys().hasOnly(['uid', 'qIndex', 'choice', 'answeredAt'])
          && request.resource.data.uid == request.auth.uid
          && validChoice(request.resource.data.choice)
          && request.resource.data.answeredAt == request.time
          && room(code).status == 'question'
          && request.resource.data.qIndex == room(code).currentIndex
          && request.time >= room(code).questionStartedAt - duration.value(1, 's')
          && request.time <= room(code).questionEndsAt
          && exists(/databases/$(database)/documents/rooms/$(code)/players/$(request.auth.uid));
        allow read: if isHost(code)
          || (signedIn() && resource.data.uid == request.auth.uid);
        allow update: if false;
        allow delete: if isHost(code);
      }
    }
  }
}
